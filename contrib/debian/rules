#!/usr/bin/make -f
# F-334: Qt executables are linked -fPIC after -fPIE, so GCC LTO does not
# copy Qt data (QGuiApplication::staticMetaObject, QCoreApplication::self)
# into the binary. Distro -flto=auto stays on. optimize=-lto hid that crash
# and is retired.
# F-388: dh_dwz writes a multifile for quicksilver-devtools. Those binaries'
# debug info then uses DW_FORM_GNU_ref_alt (0x1f20) and DW_FORM_GNU_strp_alt
# (0x1f21). debugedit 5.0 rejects both forms in read_abbrev, aborts the
# DWARF walk, and warns. dh_strip runs `debugedit --build-id` only: it does
# not pass --list-file, --base-dir, or --dest-dir, so that walk is not a
# source-file list and not a path rewrite. The command still prints a
# build-id and exits 0; the id matches the .debug file and the alt file in
# the same .ddeb. gdb symbolises the function and the file:line from that
# pair. The GUI package gets no multifile, so debugedit does not warn on it.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# depends/config.guess and config.sub belong to the depends/ build, which
# this package does not run. Replacing them with the host copies dirties
# the tree, and the binaries then stamp themselves -dirty.
override_dh_update_autotools_config:
	:

override_dh_auto_configure:
	dh_auto_configure -- \
	  -DBUILD_GUI=ON \
	  -DBUILD_DAEMON=ON \
	  -DBUILD_CLI=ON \
	  -DBUILD_AGENT=ON \
	  -DBUILD_TX=ON \
	  -DBUILD_VAULT_TOOL=ON \
	  -DBUILD_TESTS=OFF \
	  -DQS_DEVELOPER_TOOLS=ON

# git is a Build-Depends because GenerateBuildInfo.cmake stamps the binary
# from `git describe` and otherwise writes "No build information available"
# while the package still builds. That silent success is the defect: a
# .deb cannot show that it is unstamped. Fail here unless the caller set
# the cmake script's own opt-out. A tagged clean tree stamps BUILD_GIT_TAG;
# every other git tree stamps BUILD_GIT_COMMIT. Either is a stamp.
override_dh_auto_build:
	dh_auto_build
	if [ "$$QUICKSILVER_GENBUILD_NO_GIT" != "1" ]; then \
		header="obj-$$(dpkg-architecture -qDEB_HOST_GNU_TYPE)/src/quicksilver-build-info.h"; \
		test -s "$$header"; \
		grep -E -q '^#define BUILD_GIT_(TAG|COMMIT) "' "$$header"; \
	fi

# The devtools description names this path without a .gz suffix. Leave the
# file uncompressed so that path exists in the package.
override_dh_compress:
	dh_compress -Xdeveloper-tools.md

#!/sbin/openrc-run

QUICKSILVER_DAEMON_DEFAULT_DATADIR="/var/lib/quicksilver-daemon"

QUICKSILVER_DAEMON_CONFIGFILE=${QUICKSILVER_DAEMON_CONFIGFILE:-/etc/quicksilver/quicksilver.conf}
QUICKSILVER_DAEMON_PIDDIR=${QUICKSILVER_DAEMON_PIDDIR:-/var/run/quicksilver-daemon}
QUICKSILVER_DAEMON_PIDFILE=${QUICKSILVER_DAEMON_PIDFILE:-${QUICKSILVER_DAEMON_PIDDIR}/quicksilver-daemon.pid}
QUICKSILVER_DAEMON_DATADIR=${QUICKSILVER_DAEMON_DATADIR:-${QUICKSILVER_DAEMON_DEFAULT_DATADIR}}
QUICKSILVER_DAEMON_USER=${QUICKSILVER_DAEMON_USER:-${QUICKSILVER_USER:-quicksilver}}
QUICKSILVER_DAEMON_GROUP=${QUICKSILVER_DAEMON_GROUP:-quicksilver}
QUICKSILVER_DAEMON_BIN=${QUICKSILVER_DAEMON_BIN:-/usr/bin/quicksilver-daemon}
QUICKSILVER_DAEMON_NICE=${QUICKSILVER_DAEMON_NICE:-${NICELEVEL:-0}}
QUICKSILVER_DAEMON_OPTS="${QUICKSILVER_DAEMON_OPTS:-${QUICKSILVER_OPTS}}"

name="Quicksilver Daemon"
description="Quicksilver P2P network daemon"

command="${QUICKSILVER_DAEMON_BIN}"
command_args="-pid=\"${QUICKSILVER_DAEMON_PIDFILE}\" \
		-conf=\"${QUICKSILVER_DAEMON_CONFIGFILE}\" \
		-datadir=\"${QUICKSILVER_DAEMON_DATADIR}\" \
		-daemon \
		${QUICKSILVER_DAEMON_OPTS}"

required_files="${QUICKSILVER_DAEMON_CONFIGFILE}"
start_stop_daemon_args="-u ${QUICKSILVER_DAEMON_USER} \
			-N ${QUICKSILVER_DAEMON_NICE} -w 2000"
pidfile="${QUICKSILVER_DAEMON_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${QUICKSILVER_DAEMON_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${QUICKSILVER_DAEMON_USER}:${QUICKSILVER_DAEMON_GROUP}" \
	"${QUICKSILVER_DAEMON_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${QUICKSILVER_DAEMON_USER}:${QUICKSILVER_DAEMON_GROUP}" \
	"${QUICKSILVER_DAEMON_PIDDIR}"

	checkpath -f \
	-o "${QUICKSILVER_DAEMON_USER}:${QUICKSILVER_DAEMON_GROUP}" \
	-m 0660 \
	"${QUICKSILVER_DAEMON_CONFIGFILE}"

	checkconfig || return 1
}

checkconfig()
{
	if grep -qs '^rpcuser=' "${QUICKSILVER_DAEMON_CONFIGFILE}" && \
		! grep -qs '^rpcpassword=' "${QUICKSILVER_DAEMON_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run quicksilver-daemon."
		eerror "The setting must appear in ${QUICKSILVER_DAEMON_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing vaults "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following "
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"Quicksilver Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
